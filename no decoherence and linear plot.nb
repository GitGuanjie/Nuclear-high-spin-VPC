Cell["7/2 optimal results compare", "Chapter",
 CellChangeTimes->{{3.962604913548578*^9, 3.962604914139898*^9}, {
  3.9895546512250404`*^9, 
  3.9895546515123863`*^9}},ExpressionUUID->"ef8db85e-4401-164f-86e9-\
44e8491e9c03"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dim", "=", 
    RowBox[{"7", "/", "2"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SpinMatrices", "[", "s_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "d", ",", "IzMat", ",", "superDiag", ",", "Iplus", ",", "Iminus", ",", 
        "IxMat", ",", "IyMat"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Define", " ", "the", " ", "dimension", " ", "of", " ", "the", " ", 
         RowBox[{"matrices", ":", "d"}]}], "=", 
        RowBox[{
         RowBox[{"2", "s"}], "+", "1"}]}], "*)"}], 
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{
         RowBox[{"2", " ", "s"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"Construct", " ", 
           RowBox[{"Iz", ":", 
            RowBox[{
            "a", " ", "diagonal", " ", "matrix", " ", "with", " ", "entries", 
             " ", "m"}]}]}], "=", "s"}], ",", 
         RowBox[{"s", "-", "1"}], ",", "...", ",", 
         RowBox[{"-", "s"}]}], "*)"}], 
       RowBox[{"IzMat", "=", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Table", "[", 
          RowBox[{"m", ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "s", ",", 
             RowBox[{"-", "s"}], ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Compute", " ", "the", " ", "superdiagonal", " ", "elements", " ", 
          "for", " ", "I"}], "+"}], "*)"}], 
       RowBox[{"superDiag", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"s", " ", 
             RowBox[{"(", 
              RowBox[{"s", "+", "1"}], ")"}]}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"s", "-", "j"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"s", "-", "j", "+", "1"}], ")"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Construct", " ", "I"}], "+", 
         RowBox[{
         "as", " ", "a", " ", "dense", " ", "matrix", " ", "with", " ", 
          "superdiagonal", " ", "elements"}]}], "*)"}], 
       RowBox[{"Iplus", "=", 
        RowBox[{"Normal", "[", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Band", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}], "]"}], "->", "superDiag"}], ",", 
           RowBox[{"{", 
            RowBox[{"d", ",", "d"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Construct", " ", "I"}], "-", 
         RowBox[{"as", " ", "the", " ", "transpose", " ", "of", " ", "I"}], 
         "+"}], "*)"}], 
       RowBox[{"Iminus", "=", 
        RowBox[{"Transpose", "[", "Iplus", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Compute", " ", "Ix", " ", "and", " ", "Iy", " ", "from", " ", "I"}],
          "+", 
         RowBox[{"and", " ", "I"}], "-"}], "*)"}], 
       RowBox[{"IxMat", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Iplus", "+", "Iminus"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", 
